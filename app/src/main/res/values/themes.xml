<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme using Material 3 -->
    <style name="Theme.MathRewards" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- Legacy alias to ensure compatibility -->
    <style name="Theme.MyApplication" parent="Theme.MathRewards" />
</resources>
